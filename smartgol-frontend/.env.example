# Produção (Vercel): URL pública HTTPS da API no Railway (sem / no fim, sem sufixo /api).
# Ex.: https://seu-servico.up.railway.app
# Local: deixe vazio — o Vite usa proxy /api → http://localhost:3000
# VITE_API_BASE_URL=
# Data do “dia” no UI (lista de palpites) — igual a CRON_TZ no Railway (padrão implícito America/Sao_Paulo).
# VITE_APP_TIMEZONE=America/Sao_Paulo
