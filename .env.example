PORT=3000

# Local: use DB_* abaixo. Railway/Render: cole a URL pública do Postgres em DATABASE_URL (aí DB_* são ignorados).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
#
# SQLTools no Cursor (.vscode/settings.json): com DATABASE_URL no .env, no PowerShell:
#   npm run sqltools:railway-env -- --print-ps1 | Out-File railway-pg.ps1 -Encoding utf8
#   . .\railway-pg.ps1
#   cursor .
# Depois: ícone SQLTools → ligação "Railway PostgreSQL".

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=prognostico_futebol

# Primeira subida em produção: true / 1 / yes / on — cria tabelas. Depois false ou remova.
# DB_SYNC=false

# Render: true / 1 / yes / on se der erro "SSL required" na conexão
# DB_SSL=false
FOOTBALL_API_KEY=
# IDs football-data separados por vírgula (v4). Omite para usar lista larga por defeito (10 ligas incl. Brasileirão).
# FOOTBALL_COMPETITION_IDS=2021,2014,2019,2002,2015,2001,2018,2013,2017,2003,2016
# Máx. de jogos/dia para carregar odds (GET /matches/{id}/odds cada). Padrão 220 (teto absoluto no código 500).
# FOOTBALL_MAX_ODDS_ENRICH=220
# PARALELOS por lote ao buscar odds; pausa opcional entre lotes para rate-limit (ex.: BATCH 10 + PAUSE 3100).
# FOOTBALL_ODDS_BATCH_SIZE=40
# FOOTBALL_ODDS_BATCH_PAUSE_MS=0
# TTL do cache de GET /football/highlights (horas; padrão 6). Crons: ao vivo 1 min; “grade” 4x/dia
# FOOTBALL_SCHEDULE_CACHE_TTL_HOURS=6
# DISABLE_FOOTBALL_LIVE_CRON=true
# DISABLE_FOOTBALL_SCHEDULE_WARM_CRON=true

# Job diário: gera prognósticos às 00:05 (fuso CRON_TZ; padrão America/Sao_Paulo)
# CRON_TZ=America/Sao_Paulo
# DISABLE_DAILY_PREDICTION_CRON=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Meta mínima de palpites por dia (lote IA + por jogo + preenchimento por odds); padrão no código: 52
# MIN_DAILY_PREDICTIONS=52
# Partidas máx. no payload do lote IA; padrão no código 220 — alinhado a FOOTBALL_MAX_ODDS_ENRICH
# BATCH_MAX_MATCHES=220
# Palpites máx. por resposta em lote da IA; padrão no código 72
# BATCH_MAX_PICKS=72
JWT_SECRET=smartgol-dev-secret
# E-mail de um usuário já cadastrado que vira admin ao subir a API (opcional)
ADMIN_EMAIL=

# Uso único (não commitar): npm run build && definir no shell ADMIN_BOOTSTRAP_EMAIL + ADMIN_BOOTSTRAP_PASSWORD && npm run bootstrap:admin

# Mercado Pago — token de produção ou teste (https://www.mercadopago.com.br/developers)
MERCADOPAGO_ACCESS_TOKEN=
# URL pública da API (HTTPS em produção) para o webhook: {API_PUBLIC_URL}/payments/mercadopago/webhook
API_PUBLIC_URL=http://localhost:3000
# URL do site (retorno Mercado Pago + CORS no browser). Vercel: https://seu-projeto.vercel.app
# Várias origens: separar por vírgula (ex.: produção + preview Vercel)
FRONTEND_URL=http://localhost:5173